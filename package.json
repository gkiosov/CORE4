{
  "name": "CORE4",
  "version": "0.1.0",
  "description": "A modular design system built with SCSS and JavaScript, featuring themes, OKLCH colors, and a responsive grid.",
  "main": "source/js/main.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack",
    "dev": "cross-env NODE_ENV=development webpack serve",
    "start": "npm run dev",
    "watch": "cross-env NODE_ENV=development webpack --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.5.0",
    "babel-loader": "^9.1.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^6.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "css-minimizer-webpack-plugin@6.0.0": true
  },
  "sideEffects": [
    "*.scss",
    "*.css"
  ]
}
